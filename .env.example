# Banco (no docker compose a API usa o host "db" e o usuário somente leitura sales_reader)
DATABASE_URL=postgresql+psycopg2://sales:sales@localhost:5432/sales
# Recomendado: depois de rodar db/02_readonly_user.sql, use o usuário somente leitura
# DATABASE_URL=postgresql+psycopg2://sales_reader:sales_reader@localhost:5432/sales

# LLM: ollama (gratuito, local) ou openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...   (só se LLM_PROVIDER=openai, ex.: LLM_MODEL=gpt-4o-mini)
# Tempo máximo (s) de cada chamada ao LLM
LLM_TIMEOUT=300
# Tempo máximo (s) para o /health checar o LLM
LLM_HEALTH_TIMEOUT=3
# Pré-carrega o modelo do Ollama ao subir a API e o mantém carregado por OLLAMA_KEEP_ALIVE
LLM_WARMUP=true
OLLAMA_KEEP_ALIVE=30m

# Data usada como "hoje" para "última semana"/"último mês".
# Vazio = data da venda mais recente da base (2025-03-02 nos dados de exemplo).
REFERENCE_DATE=

MAX_QUESTION_LENGTH=300
MAX_ROWS_TO_LLM=50
SQL_TIMEOUT_MS=5000
# Quantas vezes o LLM pode corrigir um SQL que falhou
SQL_MAX_RETRIES=2

# Cache de respostas do /sales-insights (segundos; 0 desativa) e número máximo de itens
ANSWER_CACHE_TTL=3600
ANSWER_CACHE_SIZE=256
